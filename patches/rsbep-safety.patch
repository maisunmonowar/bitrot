diff --git a/rsbep-backup/contrib/melt.sh b/rsbep-backup/contrib/melt.sh
index a1cfc01..a455730 100755
--- a/rsbep-backup/contrib/melt.sh
+++ b/rsbep-backup/contrib/melt.sh
@@ -1,16 +1,42 @@
 #!/bin/sh
+set -eu
 if [ $# -ne 1 ] ; then
 	echo Usage: $0 filename   \(...will output to stdout\)
 	exit 1
 fi
 if [ ! -f "$1" ] ; then echo $1 is not a regular file\! ; exit 1 ; fi
 
-dd if="$1" conv=noerror,sync 2>/dev/null | rsbep -d -B 255 -D 223 -R 4080 | {
-	read SIG
-	if [ "$SIG" != "MAGIC_TTSIOD_RS" ] ; then
-		echo "Beyond capacity to correct... Sorry." > /dev/stderr
+decoded_file=`mktemp "${TMPDIR:-/tmp}/rsbep-decoded.XXXXXX"`
+recovered_file=`mktemp "${TMPDIR:-/tmp}/rsbep-recovered.XXXXXX"`
+trap 'rm -f "$decoded_file" "$recovered_file"' EXIT HUP INT TERM
+
+if ! rsbep -d -B 255 -D 223 -R 4080 < "$1" > "$decoded_file" ; then
+	echo "rsbep decoder failed." >&2
+	exit 1
+fi
+
+exec 3< "$decoded_file"
+if ! IFS= read -r SIG <&3 ; then
+	echo "Missing recovery signature." >&2
+	exit 1
+fi
+if [ "$SIG" != "MAGIC_TTSIOD_RS" ] ; then
+	echo "Beyond capacity to correct... Sorry." >&2
+	exit 1
+fi
+if ! IFS= read -r SIZE <&3 ; then
+	echo "Missing recovered size." >&2
+	exit 1
+fi
+case "$SIZE" in
+	''|*[!0-9]*)
+		echo "Invalid recovered size." >&2
 		exit 1
-	fi
-	read SIZE
-	rsbep_chopper $SIZE
-}
+		;;
+esac
+
+if ! rsbep_chopper "$SIZE" <&3 > "$recovered_file" ; then
+	echo "Recovered data is truncated." >&2
+	exit 1
+fi
+cat "$recovered_file"
